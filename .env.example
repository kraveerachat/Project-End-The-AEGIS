# AEGIS — root docker-compose.yml example environment
# Copy to a git-ignored `.env` (see .gitignore: `.env*` except `.env.example`)
# next to docker-compose.yml before running this stack anywhere it persists
# real data. All defaults below match docker-compose.yml's fallback values,
# which are fine for a disposable localhost test run but not for anything else.

# Postgres bootstrap database credentials (shared instance, per-app databases —
# see postgres/init/00-databases.sql). Both drive and monitor connect using these.
POSTGRES_USER=aegis
POSTGRES_PASSWORD=

# Session cookie signing key, shared default for drive+monitor on this stack.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Day-0 admin bootstrap for IDEA1 (server/db/bootstrapAdmin.js) ────────────
# Only relevant the FIRST time aegis_drive has zero Admin rows — irrelevant on
# this stack by default since postgres/init/ always runs IDEA1's seed.sql
# first, which already inserts a demo admin. Leave blank unless you've removed
# that seed step for a real deployment. Generate the hash with
# IDEA1-AEGIS_Drive_LC/scripts/hash_password.py — never a raw password here.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
