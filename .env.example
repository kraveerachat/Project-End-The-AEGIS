# AEGIS — root docker-compose.yml example environment
# Copy to a git-ignored `.env` (see .gitignore: `.env*` except `.env.example`)
# next to docker-compose.yml before running this stack anywhere it persists
# real data.
#
# ⚠️ ห้ามใส่ค่าจริงในไฟล์นี้เด็ดขาด — ไฟล์นี้ถูก commit ลง git ทุกครั้ง
#    ค่าทุกตัวข้างล่างต้องเป็น placeholder ที่ "เห็นแล้วรู้ทันทีว่าปลอม"
#    ค่าจริงอยู่ใน .env ที่ git ไม่แตะ (ดู .gitignore) เท่านั้น

# ── Postgres ────────────────────────────────────────────────────────────────
# บัญชี bootstrap ของ instance เดียวที่ถือสองฐาน (aegis_drive / aegis_monitor)
# — ดู postgres/init/00-databases.sql
# ⚠️ POSTGRES_PASSWORD ถูก "ฝัง" ลง volume ตอน init ครั้งแรกเท่านั้น การแก้ค่านี้
#    ทีหลังไม่เปลี่ยนรหัสใน DB ที่สร้างไปแล้ว — ต้องลบ volume แล้ว init ใหม่
# ⚠️ superuser คู่นี้ใช้ตอน init/migrate/ตรวจสอบเท่านั้น — แอปที่รันอยู่ต่อด้วย
#    drive_app/monitor_app ด้านล่าง ไม่เคยต่อด้วย superuser
POSTGRES_USER=aegis
POSTGRES_PASSWORD=changeme-choose-a-real-postgres-password

# ── DB role แยกต่อแอป (postgres/init/02-app-roles.sh สร้างให้ตอน init) ───────
# ⚠️ นี่คือชั้นที่บังคับ Identity Decoupling ด้วย SQL จริง: drive_app ถูก REVOKE
#    CONNECT จาก aegis_monitor และ monitor_app ถูก REVOKE จาก aegis_drive
#    → แอปหนึ่งเปิด connection ไปฐานของอีกแอปไม่ได้เลย ไม่ใช่แค่ "ไม่ได้ตั้งใจต่อ"
# ⚠️ สองค่านี้ต้องต่างกัน และต่างจาก POSTGRES_PASSWORD ด้วย
DRIVE_DB_PASSWORD=changeme-real-password-for-drive-app-role
MONITOR_DB_PASSWORD=changeme-real-password-for-monitor-app-role

# ── Session signing keys — หนึ่งดอกต่อหนึ่งแอป ห้ามใช้ร่วมกัน ──────────────────
# ⚠️ Identity Decoupling ระดับเซสชัน: ถ้า secret หลุดจากแอปหนึ่ง ต้องปลอม cookie
#    ของอีกแอปไม่ได้ — สองค่านี้จึงต้องต่างกันเสมอ (ห้ามคัดลอกค่าเดียวกันมาใส่ทั้งคู่)
# สร้างค่าจริงด้วย:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRIVE_SESSION_SECRET=changeme-generate-a-real-one-for-drive
MONITOR_SESSION_SECRET=changeme-generate-a-real-one-for-monitor

# ── Detection Engine ingest key (IDEA2 Monitor ⇄ Detection Engine) ───────────
# ⚠️ service-to-service เท่านั้น — Detection Engine (Laptop, VLAN 20) แนบค่านี้ทาง
#    header X-Detection-Engine-Key เวลายิง POST /internal/{detections,clips,alerts}
#    Detection Engine "ไม่" ถือ credential ต่อ Postgres โดยตรง — คุยผ่าน API นี้เท่านั้น
#    ถ้าไม่ตั้งค่า → endpoint /internal ถูกปิดตายทั้งหมด (fail-secure, 503)
# สร้างค่าจริงด้วย:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ค่าเดียวกันนี้ต้องตั้งให้ Detection Engine ด้วย (AEGIS_DETECTION_ENGINE_API_KEY)
DETECTION_ENGINE_API_KEY=changeme-generate-a-real-detection-engine-key

# Canonical IDEA2 modular runtime development settings. The service starts and
# retains recordings locally with NAS disabled. Enabling NAS requires a real
# host/user and checksum or size verification; never add credentials here.
AEGIS_NODE_ID=edge-node-01
AEGIS_CAMERA_ID=CAM-02
AEGIS_CAMERA_LABEL=Development Camera
AEGIS_CAMERA_SOURCE=0
AEGIS_NAS_ENABLED=false
AEGIS_NAS_METHOD=rsync
AEGIS_NAS_USER=
AEGIS_NAS_HOST=
AEGIS_NAS_DEST_DIR=/volume1/aegis/segments
AEGIS_NAS_VERIFY=checksum
AEGIS_TELEGRAM_BOT_TOKEN=
AEGIS_TELEGRAM_CHAT_ID=

# ── Storage Layer (IDEA1 Drive) ─────────────────────────────────────────────
# จุด mount ของ named volume `drive_storage` ในคอนเทนเนอร์ drive — ไฟล์ "ตัวจริง"
# (raw bytes) ถูกเขียนลงที่นี่ ส่วน metadata ไปอยู่ใน Postgres
# ⚠️ ห้ามเก็บรหัสผ่าน/hash ใน Storage Layer — ของพวกนั้นอยู่ Metadata Layer เท่านั้น
DRIVE_STORAGE_ROOT=/datalake

# ── Media preview derivatives (IDEA1 Drive · poster/motion cache) ───────────
# derivative (poster WebP / motion MP4) ถูกสร้างฝั่งเซิร์ฟเวอร์ด้วย sharp + ffmpeg ใน image
# แล้วเก็บใน named volume `aegis_drive_media_cache` (mount ที่ /var/cache/aegis-media)
# — สร้างใหม่ได้เสมอ ไม่ต้อง backup; ลบ volume ได้เมื่อไม่ใช้ (ดู IDEA1 docs/superpowers/specs)
# MEDIA_ENABLED=false = kill switch: ไม่ spawn ffmpeg เลย, กริดกลับไปใช้ไอคอน, upload/preview เหมือนเดิม
MEDIA_ENABLED=true
# เพดานขนาด cache (bytes) — เกินแล้ว evict แบบ LRU ลงมาที่ 80% (2 GiB)
MEDIA_CACHE_MAX_BYTES=2147483648
# จำนวน worker ที่สร้าง derivative พร้อมกัน (1..2) — 1 พอสำหรับเครื่อง 4 core
MEDIA_WORKERS=1
# engine ของภาพนิ่ง: sharp (ค่าเริ่มต้น, libvips) หรือ ffmpeg
MEDIA_STILL_ENGINE=sharp
# immutable = private, max-age=1y, immutable + Vary: Cookie (session contract พิสูจน์แล้ว)
# revalidate = private, max-age=0, must-revalidate (ETag เท่านั้น) — ใช้เมื่อ proxy หน้าเว็บไม่เคารพ private
MEDIA_CACHE_POLICY=immutable

# ── Day-0 admin bootstrap for IDEA1 (server/db/bootstrapAdmin.js) ────────────
# ใช้ครั้งเดียวตอน aegis_drive ยังไม่มีแถว Admin เลย — ปกติไม่จำเป็นบน stack นี้
# เพราะ postgres/init/ รัน seed.sql ที่มี admin เดโม่ให้อยู่แล้ว
# สร้าง hash ด้วย IDEA1-AEGIS_Drive_LC/scripts/hash_password.py — ห้ามใส่รหัสดิบ
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
