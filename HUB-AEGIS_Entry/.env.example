# AEGIS Entry — ตัวอย่างตัวแปรสภาพแวดล้อม
# ⚠️ HUB เป็น routing-only (คำตัดสินสถาปัตยกรรม 2026-07-20):
#    ไม่มี DB, ไม่มี SESSION_SECRET — ระบบตัวตนอยู่ใน IDEA1/IDEA2 แยกกันคนละชุด
#    (ดู IDEA1-AEGIS_Drive_LC/.env.example และ IDEA2-AEGIS_Monitor/.env.example)

PORT=8000
NODE_ENV=production

# ปลายทางของแต่ละโมดูลตั้งใน public/config.json (runtime config — แก้ได้โดยไม่ต้อง rebuild)
