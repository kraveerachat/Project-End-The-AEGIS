# AEGIS Drive (IDEA1) — example environment
# Copy to a git-ignored `.env` (see root .gitignore: `.env*` except `.env.example`)
# next to docker-compose.yml. Real values must never be committed.

NODE_ENV=production
PORT=8001

# Session cookie signing key — required in production (server refuses to boot
# without it). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only set to "false" on the root localhost/dev docker-compose stack, where the
# gateway terminates plain HTTP — never in a real deployment (breaks Secure cookie).
COOKIE_SECURE=true

# postgresql://<user>:<password>@<host>:5432/aegis_drive — unset to fall back
# to the in-memory dev store (see server/db/connection.js)
DATABASE_URL=

# ── Day-0 admin bootstrap (server/db/bootstrapAdmin.js) ──────────────────────
# Only used ONCE, when the `users` table has zero Admin rows. Generate the hash
# locally with `python scripts/hash_password.py` (see scripts/README.md) —
# never put a raw password here, only the bcrypt hash it prints.
# Remove both vars after the first successful boot; leaving them set is
# harmless (bootstrap no-ops once an Admin exists) but there's no reason to
# keep a bootstrap credential lying around in .env longer than needed.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD_HASH=
