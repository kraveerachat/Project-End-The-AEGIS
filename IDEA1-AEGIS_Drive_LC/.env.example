# AEGIS Drive (IDEA1) — example environment
# Copy to a git-ignored `.env` (see root .gitignore: `.env*` except `.env.example`)
# next to docker-compose.yml. Real values must never be committed.

NODE_ENV=production
PORT=8001

# Session cookie signing key — required in production (server refuses to boot
# without it). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only set to "false" on the root localhost/dev docker-compose stack, where the
# gateway terminates plain HTTP — never in a real deployment (breaks Secure cookie).
COOKIE_SECURE=true

# Required in production. Exact CIDR for the approved HUB reverse-proxy
# identity only — never use multiple values, hop counts, aliases, aegis_internal,
# or broad private ranges. Trust only HUB .2, never the full proxy network /29.
TRUSTED_PROXY_CIDRS=172.19.255.2/32

# postgresql://<user>:<password>@<host>:5432/aegis_drive — unset to fall back
# to the in-memory dev store (see server/db/connection.js)
DATABASE_URL=

# ── Day-0 admin bootstrap (server/db/bootstrapAdmin.js) ──────────────────────
# Only used ONCE, when the `users` table has zero Admin rows. Generate the hash
# locally with `python scripts/hash_password.py` (see scripts/README.md) —
# never put a raw password here, only the bcrypt hash it prints.
# Remove both vars after the first successful boot; leaving them set is
# harmless (bootstrap no-ops once an Admin exists) but there's no reason to
# keep a bootstrap credential lying around in .env longer than needed.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# ── Large-file transfer V2 (LFT-V2-A) ────────────────────────────────────────
# These control the resumable chunked upload path (server/config/transferLimits.js).
# Every value is optional; an invalid value makes the server refuse to start
# rather than silently clamping to something no file states.
#
# Size of one HTTP request in the chunked upload protocol.
# Default 16777216 (16 MiB). Accepted range 8388608–67108864 (8–64 MiB).
UPLOAD_CHUNK_SIZE_BYTES=16777216
#
# Deployment ceiling for ONE logical file. This is not a per-request limit and
# not a browser-memory limit — it is the size this deployment is willing to
# accept and store. Default 5368709120 (5 GiB), chosen as a safe value for the
# current volume, NOT as an architectural maximum. Raise it when storage grows.
MAX_LOGICAL_FILE_BYTES=5368709120
#
# How long an unfinished upload session stays resumable. Default 86400000 (24 h).
UPLOAD_SESSION_TTL_MS=86400000
#
# Commit lease. A session left in status='committing' for longer than this is
# treated as owned by a process that died, and the crash-recovery worker may
# inspect it (server/storage/commitRecovery.js). It must stay comfortably longer
# than a real commit takes: the slow step inside 'committing' is hashing the
# staged file, which for a multi-gigabyte file on an HDD is minutes.
# Setting it too low does not corrupt anything — recovery always re-reads the real
# on-disk state — but it can pull the rug from under a commit that is still
# running, and the user then has to commit again. Default 900000 (15 min).
UPLOAD_COMMIT_LEASE_MS=900000
#
# Free-space safety margin. The server accepts a new upload only when
#   freeBytes - logicalSize >= max(STORAGE_FREE_RESERVE_BYTES,
#                                  totalBytes * STORAGE_FREE_RESERVE_FRACTION)
# so a single upload can never fill the filesystem to 100% and stop PostgreSQL,
# the audit log and the session store from writing. Defaults: 2 GiB and 5%.
STORAGE_FREE_RESERVE_BYTES=2147483648
STORAGE_FREE_RESERVE_FRACTION=0.05

# ── Host agents (Unix sockets, bind-mounted read-only into the container) ─────
# Both are server-only paths; a browser never supplies either. Without the
# socket Drive reports the corresponding data as unavailable — it never guesses.
#
# Telemetry agent (shared/host-telemetry-agent): CPU/RAM/network/uptime on
# /internal/telemetry and physical disk health on /internal/disk-health.
# Drive must join GID 29100 (compose `group_add`) to read it.
AEGIS_TELEMETRY_SOCKET=/run/aegis-telemetry/telemetry.sock
#
# Backup agent (shared/host-backup-agent): backup state, job history, and the
# Admin-only run/verify/policy commands. A DIFFERENT socket, user and group
# from telemetry on purpose; Drive must join GID 29102 to reach it.
AEGIS_BACKUP_SOCKET=/run/aegis-backup/backup.sock

# ── IDEA3 read-only status bridge ───────────────────────────────────────────
# Optional absolute path to the atomic status.json written by the IDEA3
# supervisor. Leave blank until the runtime is deliberately mounted/readable by
# Drive. This path is server-only and is never accepted from a browser request.
AEGIS_IDEA3_STATUS_PATH=
# A status older than this is not presented as current. Default 30; range 1–3600.
AEGIS_IDEA3_STATUS_STALE_SEC=30
