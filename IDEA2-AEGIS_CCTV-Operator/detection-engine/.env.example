# AEGIS Monitor · Detection Engine — configuration
# Copy to `.env` and edit. Development starts without NAS, Monitor persistence,
# or Telegram. Enabling an integration opts into its required configuration.
# (A `.env` file is auto-loaded if python-dotenv is installed.)

# ---- Identity ---------------------------------------------------------------
AEGIS_NODE_ID=edge-node-01
AEGIS_CAMERA_ID=CAM-05
AEGIS_CAMERA_LABEL=Reception

# ---- Capture (VideoCatcher) -------------------------------------------------
# Webcam index (0, 1, ...) OR a stream URL (rtsp://user:pass@host/...).
AEGIS_CAMERA_SOURCE=0
AEGIS_FRAME_WIDTH=1280
AEGIS_FRAME_HEIGHT=720
AEGIS_TARGET_FPS=24
AEGIS_CAPTURE_RECONNECT_DELAY_S=2.0
AEGIS_CAPTURE_MAX_RECONNECT_DELAY_S=30.0
# false preserves continuous capture. Set true on interactive webcam nodes so
# only an authenticated Monitor stream holds the physical camera open.
AEGIS_CAPTURE_ON_DEMAND=false

# ---- Queues -----------------------------------------------------------------
AEGIS_RECORD_QUEUE_SIZE=240
AEGIS_DETECT_QUEUE_SIZE=1

# ---- Detection (FaceDetectorProcessor) --------------------------------------
# Run inference every Nth frame (1 = every frame). Raise to throttle a heavy model.
AEGIS_DETECT_EVERY_N_FRAMES=1
AEGIS_DETECT_MIN_CONFIDENCE=60.0
# Safe default has no identity claim. The trained YOLO model remains the first
# gate, but SFace must verify identity before the engine returns Authorized.
# Every model/template path is local-only and must never be committed.
AEGIS_RECOGNIZER_BACKEND=placeholder
AEGIS_ADMIN_MODEL_PATH=
AEGIS_ADMIN_CLASS_NAME=Admin-Face-Scan
AEGIS_ADMIN_DISPLAY_NAME=Admin
AEGIS_ADMIN_MIN_CONFIDENCE=50.0
AEGIS_FACE_DETECTOR_MODEL_PATH=
AEGIS_FACE_RECOGNIZER_MODEL_PATH=
AEGIS_ADMIN_EMBEDDINGS_PATH=
AEGIS_FACE_MATCH_COSINE_THRESHOLD=0.50
AEGIS_FACE_DETECTOR_SCORE_THRESHOLD=0.60
AEGIS_FACE_DETECTOR_MAX_SIDE=640
AEGIS_YOLO_GATE_TTL_S=2.0
AEGIS_UNKNOWN_MIN_FACE_RATIO=0.12
AEGIS_UNKNOWN_LARGE_FACE_RATIO=0.22

# ---- Recording (SegmentRecorder) --------------------------------------------
AEGIS_SEGMENT_SECONDS=600          # ~10 minutes per file
AEGIS_SEGMENT_DIR=./segments
AEGIS_SEGMENT_FOURCC=mp4v
AEGIS_SEGMENT_EXTENSION=mp4

# ---- Alerts (AlertManager / Telegram) ---------------------------------------
# Leave the token/chat blank to run alerts in DRY-RUN (snapshots saved, nothing sent).
AEGIS_TELEGRAM_BOT_TOKEN=
AEGIS_TELEGRAM_CHAT_ID=
AEGIS_ALERT_COOLDOWN_S=30.0
AEGIS_ALERT_SNAPSHOT_DIR=./snapshots
AEGIS_ALERT_HTTP_TIMEOUT_S=10.0

# ---- Monitor integration ---------------------------------------------------
# Leave URL/key blank for standalone development. Detection and recording keep
# running, but no event/clip/alert/heartbeat rows are persisted to Monitor.
AEGIS_MONITOR_API_BASE=
AEGIS_DETECTION_ENGINE_API_KEY=
AEGIS_MONITOR_HTTP_TIMEOUT_S=5.0

# ---- NAS sync (NASSyncWorker) -----------------------------------------------
# Development default: retain finalized recordings locally and report NAS as
# disabled. Set true only with a reachable host and real integrity verification.
AEGIS_NAS_ENABLED=false
AEGIS_NAS_METHOD=rsync             # rsync | scp  (use scp on bare Windows)
AEGIS_NAS_USER=
AEGIS_NAS_HOST=
AEGIS_NAS_DEST_DIR=/volume1/aegis/segments
AEGIS_NAS_SSH_PORT=22
AEGIS_NAS_SSH_KEY=                 # path to private key; blank = agent/default
AEGIS_NAS_VERIFY=checksum          # checksum | size (unverified success is forbidden)
AEGIS_NAS_DELETE_AFTER_SYNC=true
AEGIS_NAS_MAX_RETRIES=3
AEGIS_NAS_RETRY_BACKOFF_S=5.0
AEGIS_NAS_TRANSFER_TIMEOUT_S=600.0

# ---- Local API (LocalEventAPI) ----------------------------------------------
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8077
AEGIS_API_METRICS_INTERVAL_S=1.0
AEGIS_API_RECENT_EVENTS=100

# ---- Live stream + heartbeat ------------------------------------------------
AEGIS_STREAM_ENABLED=true
AEGIS_STREAM_JPEG_QUALITY=70
AEGIS_STREAM_MAX_FPS=12.0
AEGIS_STREAM_PUBLIC_URL=
AEGIS_STREAM_IDLE_TIMEOUT_S=15
AEGIS_HEARTBEAT_INTERVAL_S=5.0

# ---- Logging ----------------------------------------------------------------
AEGIS_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
AEGIS_LOG_JSON=false
