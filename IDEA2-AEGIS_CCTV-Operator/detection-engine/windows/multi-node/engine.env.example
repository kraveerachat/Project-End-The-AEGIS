# TARGET-SPECIFIC OVERRIDE CHECKLIST ? NOT A STANDALONE INSTALLABLE .env.
# Start from the current canonical detection-engine/.env.example OUTSIDE Git,
# then apply only reviewed target-specific values from this checklist.
# Do not commit the completed file.

# Unique target Node. Discover/approve during the target provisioning gate.
AEGIS_NODE_ID=

# Event-time logical alias used by detection/clip/alert payloads.
# This is NOT physical identity and is NOT automatically selected from the
# operator CAM-01 / operator2 CAM-02 account policy. Current Engine runtime has
# one static value per process. Fill only after event-attribution review.
AEGIS_CAMERA_ID=
AEGIS_CAMERA_LABEL=

# Discover on this target only. Do not copy another machine's camera index.
AEGIS_CAMERA_SOURCE=
AEGIS_CAPTURE_ON_DEMAND=true

# Use current approved deployment values at provisioning time.
AEGIS_MONITOR_INGEST_MODE=identity_agent
AEGIS_IDENTITY_AGENT_PIPE_NAME=\\.\pipe\AEGIS.IdentityAgent.v1
AEGIS_IDENTITY_BROWSER_ALLOWED_ORIGINS=
AEGIS_AGENT_ENGINE_STREAM_URL=
AEGIS_MONITOR_API_BASE=

# Secret: populate only in the target-local completed file if the approved
# deployment still requires this field. Never commit a real value.
AEGIS_DETECTION_ENGINE_API_KEY=

AEGIS_STREAM_ENABLED=true
AEGIS_STREAM_PUBLIC_URL=
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8077

# Recording/NAS settings intentionally omitted here.
# Take them from the current approved merged deployment configuration when
# provisioning occurs; do not freeze values from a separate pending PR.
