# Copy OUTSIDE Git before filling real target values.
# This template is non-secret. The completed file is machine-local.

AEGIS_AGENT_MONITOR_BASE_URL=
AEGIS_AGENT_AUTH_AUDIENCE=

# Must be a unique reviewed Node ID for this target.
AEGIS_AGENT_NODE_ID=

# Use the exact server-approved key version.
AEGIS_AGENT_KEY_VERSION=

# Discover on this target from the intended interactive Engine account.
AEGIS_AGENT_ENGINE_USER_SID=

# Exact browser origins only; no wildcard.
AEGIS_IDENTITY_BROWSER_ALLOWED_ORIGINS=

# Stable server-owned stream source for this target's unique reverse listener.
AEGIS_AGENT_ENGINE_STREAM_URL=

# Optional reviewed public CA bundle path.
AEGIS_AGENT_CA_BUNDLE=
