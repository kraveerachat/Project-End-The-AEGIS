# AEGIS Monitor (IDEA2) — example environment
# Copy to a git-ignored `.env` (see root .gitignore: `.env*` except `.env.example`)
# next to docker-compose.yml. Real values must never be committed.

NODE_ENV=production
PORT=8002

# Session cookie signing key — required in production.
SESSION_SECRET=

# Only "false" on the root localhost/dev docker-compose stack (plain-HTTP gateway).
COOKIE_SECURE=true

# postgresql://<user>:<password>@<host>:5432/aegis_monitor — unset to fall back
# to the in-memory dev store (see server/db/connection.js)
DATABASE_URL=

# Dedicated Identity Agent audience. Production must use this exact non-secret
# identifier; an unset/different value fails Agent authentication closed.
AGENT_AUTH_AUDIENCE=urn:aegis:monitor:idea2:production

# Rollout switch for server-side verified-machine stream authority. Omitted or
# false preserves the legacy compatibility route; true never falls back.
AEGIS_REQUIRE_LOCAL_NODE_ASSOCIATION=false

# Strict physical streams require an explicit server-owned source per registered
# physical camera. The hostname is a stable deployment alias mapped into the
# Monitor container; it must never be a dynamic Docker bridge IP. Example only:
# replace IDs/ports with reviewed registry/tunnel values at deployment.
# Missing/mismatched entries fail closed. These settings contain no credential.
AEGIS_MONITOR_STREAM_HOST=aegis-stream-host.internal
AEGIS_TRUSTED_PHYSICAL_STREAM_SOURCES={}

# ── server/cli/manage_users.py (SSH-only operator provisioning) ──────────────
# The CLI connects directly to Postgres — it is NOT part of this app's own
# process and reads its own DATABASE_URL from the shell environment when you
# run it, not from this file. See server/cli/README.md.
