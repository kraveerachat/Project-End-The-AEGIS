# AEGIS Monitor (IDEA2) — example environment
# Copy to a git-ignored `.env` (see root .gitignore: `.env*` except `.env.example`)
# next to docker-compose.yml. Real values must never be committed.

NODE_ENV=production
PORT=8002

# Session cookie signing key — required in production.
SESSION_SECRET=

# Only "false" on the root localhost/dev docker-compose stack (plain-HTTP gateway).
COOKIE_SECURE=true

# postgresql://<user>:<password>@<host>:5432/aegis_monitor — unset to fall back
# to the in-memory dev store (see server/db/connection.js)
DATABASE_URL=

# ── server/cli/manage_users.py (SSH-only operator provisioning) ──────────────
# The CLI connects directly to Postgres — it is NOT part of this app's own
# process and reads its own DATABASE_URL from the shell environment when you
# run it, not from this file. See server/cli/README.md.
