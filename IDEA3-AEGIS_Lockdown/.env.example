# AEGIS IDEA3 configuration template — never place real values in source control.
AEGIS_PROFILE=development
AEGIS_BROKER_IP=127.0.0.1
AEGIS_BROKER_PORT=1883
AEGIS_MQTT_USER=
AEGIS_MQTT_PASS=
AEGIS_HMAC_SECRET=
AEGIS_ADMIN_PIN=
AEGIS_TG_TOKEN=
AEGIS_TG_CHAT=
AEGIS_DB_PATH=.aegis-runtime/aegis_audit.db
AEGIS_LOG_PATH=logs/aegis_soc.log

# Autonomous runtime safety defaults
AEGIS_DRY_RUN=1
AEGIS_AUTO_CONTAIN=0
AEGIS_START_DETECTOR=0
AEGIS_START_GUI=0
AEGIS_VOICE_ENABLE=0
AEGIS_HEALTH_INTERVAL=5
AEGIS_MAX_RESTARTS=5
AEGIS_RESTART_WINDOW_SEC=300

# Web Security Center / production reliability
NODE_ENV=development
PORT=8003

# Production policy:
# - SESSION_SECRET: >=32 chars, not the development default/repeated-char value,
#   and must contain at least 3 character classes.
# - AEGIS_IDEA3_ADMIN_PASSWORD_HASH: bcrypt cost 12-31 in production.
SESSION_SECRET=
AEGIS_IDEA3_ADMIN_USER=admin
AEGIS_IDEA3_ADMIN_PASSWORD_HASH=

# Development login is always disabled when NODE_ENV=production.
AEGIS_ALLOW_DEV_LOGIN=false
AEGIS_IDEA3_DEV_PASSWORD=

# Demo Mode is always disabled in production.
AEGIS_DEMO_ALLOWED=false

AEGIS_SESSION_IDLE_MS=1800000
# Production requires an absolute path. The composite service derives this from
# AEGIS_DATA_DIR and does not write into the application payload.
AEGIS_IDEA3_AUDIT_DB_PATH=

# Read-only security evidence adapters
AEGIS_IDEA1_STATUS_URL=
AEGIS_IDEA2_STATUS_URL=
AEGIS_IDEA3_RUNTIME_STATUS_URL=
AEGIS_MAX_EVIDENCE_AGE_MS=120000
AEGIS_ADAPTER_TIMEOUT_MS=2500

# Dedicated per-source integration credentials for the reviewed upstream feeds.
# One credential per source; never reuse a human Admin/SOC session cookie or the
# IDEA2 detection-engine key. Leave empty until each upstream owner provisions a
# reviewed read-only feed; the adapter then stays NOT_CONFIGURED and fails closed.
AEGIS_IDEA1_INTEGRATION_TOKEN=
AEGIS_IDEA2_INTEGRATION_TOKEN=
# PR10 S2 Server -> Core dispatch boundary (repository-only; disabled by default).
# When enabled, each new Admin acceptance mints one pending CUT_UPLINK action;
# a later S2 task adds the machine listener. Keep it disabled until the separately
# authorized K4/K5/K7 Production work supplies real values.
# - AEGIS_IDEA3_DISPATCH_PORT: application/container-internal listener port; it
#   is never host-published. HUB/NGINX on HTTPS 443 stays the only external entry.
# - AEGIS_IDEA3_DISPATCH_HOST: machine listener bind address (one IP literal).
#   It defaults to 127.0.0.1 outside production only. Production requires an
#   explicit non-loopback address on the dedicated HUB<->IDEA3 internal network.
# - AEGIS_IDEA3_DISPATCH_TRUSTED_PROXY: the HUB's pinned address (one IP literal).
# - AEGIS_IDEA3_DISPATCH_EXPECTED_SUBJECT: the expected machine client name.
AEGIS_IDEA3_DISPATCH_ENABLED=false
AEGIS_IDEA3_DISPATCH_PORT=
AEGIS_IDEA3_DISPATCH_HOST=
AEGIS_IDEA3_DISPATCH_TRUSTED_PROXY=
AEGIS_IDEA3_DISPATCH_EXPECTED_SUBJECT=

# ---------------------------------------------------------------------------
# Composite production and Windows standalone runtimes
# ---------------------------------------------------------------------------
# Writable state lives OUTSIDE the installed payload. On Windows the default is
# %LOCALAPPDATA%\AEGIS\IDEA3; set AEGIS_DATA_DIR to override with an absolute path.
AEGIS_DATA_DIR=
# Absolute path to an explicit config file; otherwise <data dir>/config/.env is used.
AEGIS_CONFIG_FILE=

# Server payload overrides. Defaults are the current application root,
# <application root>/web/server/index.js, <application root>/web/dist, and the
# node executable found on PATH. Any explicit value must be absolute.
AEGIS_APPLICATION_ROOT=
AEGIS_NODE_EXECUTABLE=
AEGIS_WEB_ENTRYPOINT=

# Production Web runtime. AEGIS_WEB_STATIC_DIR is REQUIRED in production and must
# be the absolute path of the built React assets shipped in the bundle.
AEGIS_WEB_BASE_PATH=/security
AEGIS_WEB_STATIC_DIR=
# Loopback only: 127.0.0.1 or ::1. Any other value is rejected.
AEGIS_BIND_HOST=127.0.0.1
# Launcher loopback control port; must differ from PORT.
AEGIS_CONTROL_PORT=8103
