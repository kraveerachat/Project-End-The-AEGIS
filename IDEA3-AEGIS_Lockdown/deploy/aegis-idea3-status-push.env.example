# AEGIS IDEA3 Core status push client — TEMPLATE, NOT INSTALLED, NOT ACTIVE. Non-secret values only.
# The client is disabled unless the line below is exactly 1. Installing this file does not enable anything.
AEGIS_CORE_STATUS_PUSH_ENABLED=0
AEGIS_CORE_STATUS_PUSH_BASE_URL=https://idea3-core.aegis.internal/security/api/machine/v1
AEGIS_CORE_STATUS_PUSH_SOURCE=/run/aegis-idea3/status.json
# Paths only: the private key stays in its 0600/0640 file and is never placed in this file or on a command line.
AEGIS_CORE_STATUS_PUSH_CA_FILE=/etc/aegis-idea3/pki/hub-server-ca.crt
AEGIS_CORE_STATUS_PUSH_CLIENT_CERT=/etc/aegis-idea3/pki/idea3-core-client.crt
AEGIS_CORE_STATUS_PUSH_CLIENT_KEY=/etc/aegis-idea3/pki/idea3-core-client.key
AEGIS_CORE_STATUS_PUSH_INTERVAL_SEC=10
