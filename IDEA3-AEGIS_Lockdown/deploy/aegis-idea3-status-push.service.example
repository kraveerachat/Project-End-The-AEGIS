# AEGIS IDEA3 Core status push client — TEMPLATE, NOT INSTALLED, NOT REVIEWED FOR PRODUCTION.
# Runs from the immutable status sidecar package (deploy/status-sidecar/build-status-sidecar.py), NOT from the Core release:
# `tools/` and `aegis_soc/observer.py` are not in any Core release and the Core release contract is deliberately unchanged.
# Installing the sidecar into /opt/aegis-idea3-status is a separate owner-run step that does not exist yet (doc/Content/12).
# Separate unit by design: it is not part of aegis-idea3-core.service, so a failure here cannot affect supervision.
# Owner decisions needed first: the Web side must run with AEGIS_IDEA3_STATUS_INGEST_ENABLED=true, the HUB machine
# route must be reachable from this host, and the Core user (or a dedicated group) must be allowed to read the
# client key. Do not start, enable or reload anything without a written maintenance window.
[Unit]
Description=AEGIS IDEA3 Core read-only status push client
After=aegis-idea3-core.service network-online.target
Wants=network-online.target
# Ordering only on the Core. Deliberately NO Requires=/BindsTo=/PartOf= on aegis-idea3-core.service: the pusher can fail independently.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=aegis-idea3
EnvironmentFile=/etc/aegis-idea3/status-push.env
WorkingDirectory=/opt/aegis-idea3-status/current
ExecStart=/usr/bin/python3 -E -s -B -m tools.status_push_client
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/run/aegis-idea3 /etc/aegis-idea3/pki /opt/aegis-idea3-status
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
# Owner decision: restrict egress to the HUB machine endpoint once its address is known, e.g. IPAddressDeny=any plus
# IPAddressAllow=<HUB_ADDRESS>. Left open here because the Core-to-HUB route is unverified (doc/Content/12).
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
SystemCallFilter=@system-service
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077
TimeoutStopSec=10

# Intentionally no [Install] section: enabling at boot is a separate, explicit owner decision.
