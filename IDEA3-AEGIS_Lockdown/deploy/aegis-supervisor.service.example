[Unit]
Description=AEGIS IDEA3 Autonomous Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace both /opt/aegis-idea3 paths during installation.
WorkingDirectory=/opt/aegis-idea3
EnvironmentFile=/opt/aegis-idea3/.env
Environment=AEGIS_DB_PATH=/opt/aegis-idea3/.aegis-runtime/aegis_audit.db
Environment=AEGIS_LOG_PATH=/opt/aegis-idea3/logs/aegis_soc.log
ExecStart=/opt/aegis-idea3/venv/bin/python -m aegis_soc.supervisor --profile production --headless
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStopSec=15

# Basic service hardening. Add only the device/journal permissions required by
# the selected detector deployment; never grant broad privileges by default.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/aegis-idea3/.aegis-runtime /opt/aegis-idea3/logs

[Install]
WantedBy=multi-user.target
