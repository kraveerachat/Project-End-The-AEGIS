# /etc/aegis-beelink-agent/agent.env  (mode 0640 root:aegis-agent). Paths only: no secret is stored in this file.
AEGIS_BEELINK_BROKER_HOST=core.example.invalid
AEGIS_BEELINK_BROKER_PORT=8883
# The broker is VERIFIED against this CA, hostname included. Use a DNS name the broker certificate carries:
AEGIS_BEELINK_TLS_SERVER_NAME=mqtt.aegis.home.arpa
AEGIS_BEELINK_CA_FILE=/etc/aegis-beelink-agent/pki/ca.crt
# CN must be aegis-alert-<source>; extendedKeyUsage clientAuth; key mode 0600 or 0400 owned by aegis-agent.
AEGIS_BEELINK_CLIENT_CERT=/etc/aegis-beelink-agent/pki/aegis-alert-beelink.crt
AEGIS_BEELINK_CLIENT_KEY=/etc/aegis-beelink-agent/pki/aegis-alert-beelink.key
AEGIS_BEELINK_SOURCE=beelink
