# Core side: add to the Core's environment ONLY for a reviewed lab/production stage. Inert unless AEGIS_REMOTE_ALERTS=YES, and it
# requires AEGIS_GRADUATED_RESPONSE=YES. Every variable below is mandatory when enabled (a half-configured ingress does not start).
AEGIS_REMOTE_ALERTS=YES
AEGIS_REMOTE_ALERT_BROKER_HOST=127.0.0.1
AEGIS_REMOTE_ALERT_BROKER_PORT=8883
AEGIS_REMOTE_ALERT_TLS_SERVER_NAME=mqtt.aegis.home.arpa
# CA that signed the BROKER certificate:
AEGIS_REMOTE_ALERT_CA_FILE=/etc/aegis-idea3/remote-alert/broker-ca.crt
# The Core's OWN client certificate for the broker (CN aegis-core), key mode 0600/0400:
AEGIS_REMOTE_ALERT_CORE_CERT=/etc/aegis-idea3/remote-alert/aegis-core.crt
AEGIS_REMOTE_ALERT_CORE_KEY=/etc/aegis-idea3/remote-alert/aegis-core.key
# CA that signs the SENDERS' certificates (a dedicated CA, separate from the device/broker CA, is recommended):
AEGIS_REMOTE_ALERT_CLIENT_CA_FILE=/etc/aegis-idea3/remote-alert/agent-ca.crt
AEGIS_REMOTE_ALERT_SOURCES=beelink
# Optional: pin the sender's leaf certificate (lowercase SHA-256 of the DER; comma list while rotating):
# AEGIS_REMOTE_ALERT_PIN_BEELINK=<64 hex>
# What a CONFIRMED CUT for this source reaches: NONE (default, refuses) | DRYRUN (records "would cut", lab verification) |
# LAB_RELAY (the lab Core's single relay; accepted in the lab profile only):
AEGIS_REMOTE_RELAY_BEELINK=NONE
