# Broker listener for the remote alert channel (add to the Core broker, or run a dedicated instance). PROVIDED, NOT APPLIED.
# Layer 1 of 2: the broker refuses any peer without a client certificate from the sender CA and confines each identity to its own
# topic. Layer 2 (the Core re-verifies the certificate and signature carried inside every alert) does not depend on this file.
listener 8883
protocol mqtt
cafile /etc/mosquitto/remote-alert/client-ca.crt
certfile /etc/mosquitto/remote-alert/broker.crt
keyfile /etc/mosquitto/remote-alert/broker.key
tls_version tlsv1.2
require_certificate true
use_identity_as_username true
allow_anonymous false
acl_file /etc/mosquitto/remote-alert/acl
max_packet_size 8192
