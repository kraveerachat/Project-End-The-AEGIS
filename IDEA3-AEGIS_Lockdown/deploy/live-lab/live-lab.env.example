# IDEA3 live lab parameters. Copy to <live-lab dir>/live-lab.env (default dir: ~/aegis-live-lab) and edit.
# Shell syntax, no secrets. Anything not set keeps the default shown.

# --- required: host specific -------------------------------------------------------------------------------------
AP_IFACE=wlan0                 # Wi-Fi interface that BECOMES the lab AP. Never connect it to another network.
INTERNET_IFACE=usb0            # interface that keeps the default route (Internet/Telegram). The scripts never touch it.

# --- optional ----------------------------------------------------------------------------------------------------
#AEGIS_LIVE_DIR=$HOME/aegis-live-lab   # work dir: etc/ secrets/ data/ logs/ evidence/ venv/ (set in the environment, not here)
#AP_SSID=AEGIS-IDEA3-LAB
#AP_CHANNEL=1                  # 1..13 (country rules apply: set the regulatory domain on the host first)
#AP_ADDR=10.77.30.1
#AP_PREFIXLEN=28               # main's AP isolation templates assume a /28
#DHCP_START=10.77.30.2
#DHCP_END=10.77.30.14
#BROKER_HOSTNAME=mqtt.aegis.home.arpa    # must equal the DNS SAN of the broker certificate (no IP SAN)
#DEVICE_ID=aegis-relay-01
#MQTT_CORE_USER=idea3-core
#MQTT_DEV_USER=idea3-dev-aegis-relay-01
#NTP_UPSTREAM=pool.ntp.org     # reached through INTERNET_IFACE; the lab also serves a local stratum 10 fallback
#NM_PROFILE=AEGIS-LIVE-AP
#NFT_TABLE=aegis_live
#UNIT_PREFIX=aegis-live
#RUNTIME_DIR=/run/aegis-live
#CORE_USER=                    # account that runs the Core, default: the user running the scripts
#DNS_CHECK_HOST=example.com    # resolved before and after the AP comes up (DNS safety check)
#AEGIS_VENV=                   # default <live-lab dir>/venv (python -m venv, pip install -r requirements.txt)

# Units that would collide with the lab (ports 53/67/123/8883), for example a previously installed Core, broker or DHCP.
# They are STOPPED (never disabled) and listed in evidence/stopped-units.txt so you can start them again.
#STOP_UNITS="example-core.service example-mosquitto.service example-dnsmasq.service"
