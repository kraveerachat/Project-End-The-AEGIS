# AEGIS IDEA3 live-lab Core environment. Rendered ONCE by aegis-live-up.sh into <live-lab dir>/etc/core.env (mode 0600) and
# never overwritten afterwards, so values you add by hand (Telegram) survive. Credentials (message keys, MQTT and admin
# secrets) are NOT here: the Core unit receives them as systemd credentials.
AEGIS_APPLICATION_ROOT=@APP_DIR@
AEGIS_DATA_DIR=@DATA_DIR@
AEGIS_CONFIG_FILE=@ETC_DIR@/core.env
AEGIS_DB_PATH=@DATA_DIR@/data/core-audit.sqlite3
AEGIS_CORE_PROTOCOL_DB_PATH=@DATA_DIR@/data/core-protocol.sqlite3
AEGIS_RUNTIME_DIR=@RUNTIME_DIR@
AEGIS_RUNTIME_LOG_DIR=@LOGS_DIR@
AEGIS_LOG_PATH=@LOGS_DIR@/aegis_soc.log
AEGIS_PROFILE=lab
AEGIS_DRY_RUN=0
AEGIS_AUTO_CONTAIN=0
AEGIS_START_DETECTOR=0
AEGIS_START_GUI=0
AEGIS_VOICE_ENABLE=0
AEGIS_BROKER_IP=@AP_ADDR@
AEGIS_BROKER_PORT=8883
AEGIS_MQTT_TLS=1
AEGIS_MQTT_CA_FILE=@SECRETS_DIR@/pki/ca.crt
AEGIS_MQTT_TLS_SERVER_NAME=@BROKER_HOSTNAME@
AEGIS_MQTT_USER=@MQTT_CORE_USER@
AEGIS_PROTOCOL_MODE=v1
AEGIS_P1_DEVICE_ID=@DEVICE_ID@
AEGIS_CORE_DISPATCH_ENABLED=0
AEGIS_LOCAL_CUT_ENABLED=YES
AEGIS_LOCAL_CUT_SOCKET=@RUNTIME_DIR@/cut.sock
AEGIS_LOCAL_CUT_OPERATOR_UID=@OPERATOR_UID@
AEGIS_LOCAL_CUT_SOCKET_GID=@OPERATOR_GID@
AEGIS_LOCAL_CUT_CREDENTIAL_FILE=@SECRETS_DIR@/cut.credential
AEGIS_RESTORE_CREDENTIAL_FILE=@SECRETS_DIR@/restore.credential
# Telegram notifications: add AEGIS_TG_TOKEN and AEGIS_TG_CHAT here yourself (never commit them), then restart the Core.
