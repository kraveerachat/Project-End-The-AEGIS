# SOURCE-ONLY. INERT BY DEFAULT. Contains no secret.
# Candidate Core fragment: /etc/aegis-idea3/manual-cut.env, root:root 0644.
# The drop-in loads it into aegis-idea3-core.service. Never install, populate,
# or enable it without independent review and written Human Owner authorization.
AEGIS_LOCAL_CUT_ENABLED=
AEGIS_LOCAL_CUT_SOCKET=/run/aegis-idea3-cut/cut.sock
# Exact canonical decimal uid of the one approved Desktop operator. Must be
# non-root and must be a member of the dedicated transport group; do not use an
# unrelated shared group or substitute the Core uid or uid 0.
AEGIS_LOCAL_CUT_OPERATOR_UID=
# Exact canonical decimal gid of the dedicated aegis-idea3-cut group. It must
# match the tmpfiles rule and the group named by SupplementaryGroups.
AEGIS_LOCAL_CUT_SOCKET_GID=
# Fresh Core-owned mode-0600 scrypt credential created specifically with
# aegis_soc.local_cut.write_cut_credential. Never point this at, copy, or reuse
# the D4 RESTORE credential file or its secret.
AEGIS_LOCAL_CUT_CREDENTIAL_FILE=/etc/aegis-idea3/credentials/manual-cut.credential

# Separate Desktop-process opt-in. The Desktop launcher must receive this value
# and the same absolute socket path explicitly; loading the Core fragment does
# not configure or authorize a Desktop process.
AEGIS_DESKTOP_CUT_ENABLED=
