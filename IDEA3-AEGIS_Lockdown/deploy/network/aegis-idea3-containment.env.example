# AEGIS IDEA3 containment helper configuration — TEMPLATE, NOT DEPLOYED.
# Comma-separated IPv4 CIDRs that can never be blocked. Required: the helper
# refuses to start when this is missing or malformed. The renderer seeds the
# private AP subnet so the ESP32 controller link can never be software-blocked;
# append management/operator CIDRs before L2 apply.
AEGIS_CONTAINMENT_PROTECTED_CIDRS=<AEGIS_AP_SUBNET>
