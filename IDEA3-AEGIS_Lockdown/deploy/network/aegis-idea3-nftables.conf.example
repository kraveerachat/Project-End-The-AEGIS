#!/usr/sbin/nft -f
# AEGIS IDEA3 private AP isolation — TEMPLATE, NOT DEPLOYED.
# The AP rules affect only traffic arriving from the IDEA3 AP interface.
# blocked_ipv4 is the dynamic software-containment set. Its elements are owned
# by aegis-idea3-containment.service (IPv4 only); L2 owns the table lifecycle.
# Elements are runtime state: reloading or deleting this table clears them.

table inet aegis_idea3 {
    set blocked_ipv4 {
        type ipv4_addr
        size 4096
    }

    chain input {
        type filter hook input priority filter; policy accept;

        # Software containment precedes every accept in this table. A drop is
        # final across all tables, so other tables' accepts cannot undo it.
        ip saddr @blocked_ipv4 drop

        # DHCP must also allow the pre-lease client state.
        iifname "<AEGIS_AP_INTERFACE>" udp dport 67 accept

        iifname "<AEGIS_AP_INTERFACE>" udp dport 53 ip saddr <AEGIS_AP_SUBNET> accept
        iifname "<AEGIS_AP_INTERFACE>" tcp dport 53 ip saddr <AEGIS_AP_SUBNET> accept
        iifname "<AEGIS_AP_INTERFACE>" udp dport 123 ip saddr <AEGIS_AP_SUBNET> accept
        iifname "<AEGIS_AP_INTERFACE>" tcp dport 8883 ip saddr <AEGIS_AP_SUBNET> accept

        iifname "<AEGIS_AP_INTERFACE>" tcp dport 1883 drop
        iifname "<AEGIS_AP_INTERFACE>" drop
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        ip saddr @blocked_ipv4 drop

        iifname "<AEGIS_AP_INTERFACE>" drop
    }
}
