# AEGIS IDEA3 dedicated machine-client CA — OpenSSL configuration TEMPLATE.
#
# For Kla (kraveerachat) only, on the offline CA host. Nothing here is executed
# by any IDEA3 task, and no key or certificate is generated by this repository.
# The CA private key never reaches the AEGIS Server, this repository, or IDEA3.
#
# This CA is dedicated: it is not the AEGIS Internal Root CA that signs the
# browser/server certificates, and not the D2 MQTT CA. It issues clientAuth
# certificates only, at path length 0.
#
# Layout Kla creates once, with umask 077:
#   idea3-client-ca/{private,certs,newcerts,crl}
#   touch idea3-client-ca/index.txt
#   echo 1000 > idea3-client-ca/serial
#   echo 1000 > idea3-client-ca/crlnumber

[ ca ]
default_ca = idea3_client_ca

[ idea3_client_ca ]
dir               = ./idea3-client-ca
database          = $dir/index.txt
new_certs_dir     = $dir/newcerts
certificate       = $dir/certs/idea3-machine-client-ca.crt
private_key       = $dir/private/idea3-machine-client-ca.key
serial            = $dir/serial
crlnumber         = $dir/crlnumber
default_md        = sha256
policy            = idea3_policy
x509_extensions   = idea3_client
default_days      = 90          # K10: about 90 days, renewed around day 60
# The HUB refuses every client while the CRL is expired, which fails closed and
# pauses dispatch. Kla regenerates the CRL well before nextUpdate.
default_crl_days  = 30
unique_subject    = no
copy_extensions   = none        # never copy CSR-supplied extensions
email_in_dn       = no
rand_serial       = yes

[ idea3_policy ]
commonName             = supplied
countryName            = optional
organizationName       = optional
organizationalUnitName = optional

# Extensions for an issued Core client certificate. clientAuth only: this
# certificate can never authenticate a server.
[ idea3_client ]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = critical, clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always

# Extensions for the CA certificate itself (self-signed once, at creation).
[ idea3_ca_root ]
basicConstraints       = critical, CA:TRUE, pathlen:0
keyUsage               = critical, keyCertSign, cRLSign
subjectKeyIdentifier   = hash
