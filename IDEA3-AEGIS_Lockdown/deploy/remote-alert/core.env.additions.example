# Add to the Core environment for a reviewed stage. Requires AEGIS_GRADUATED_RESPONSE=YES.
AEGIS_REMOTE_ALERTS=YES
AEGIS_REMOTE_ALERT_BROKER_HOST=127.0.0.1
AEGIS_REMOTE_ALERT_BROKER_PORT=8884
AEGIS_REMOTE_ALERT_TLS_SERVER_NAME=<BROKER_DNS_NAME>
AEGIS_REMOTE_ALERT_CA_FILE=<BROKER_CA_CERT>
AEGIS_REMOTE_ALERT_CORE_CERT=<CORE_CLIENT_CERT>
AEGIS_REMOTE_ALERT_CORE_KEY=<CORE_CLIENT_KEY>
AEGIS_REMOTE_ALERT_CLIENT_CA_FILE=<SENDER_CA_CERT>
AEGIS_REMOTE_ALERT_SOURCES=<SOURCE_ID>
# NONE refuses, DRYRUN records "would cut". A physical confirm for a remote source is refused by the Core.
AEGIS_REMOTE_RELAY_<SOURCE_ID_UPPER>=DRYRUN
