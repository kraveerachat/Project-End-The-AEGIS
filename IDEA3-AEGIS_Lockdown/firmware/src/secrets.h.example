#pragma once

// Public trust anchor only. Replace this placeholder with the dedicated MQTT
// CA certificate during device provisioning; never place private keys here.
#define SECRET_MQTT_CA_CERT                                                     \
  "-----BEGIN CERTIFICATE-----\n"                                              \
  "REPLACE_WITH_DEDICATED_AEGIS_MQTT_CA_CERTIFICATE\n"                       \
  "-----END CERTIFICATE-----\n"

// Bootstrap default for the Core-local, AP-bound NTP service. Provisioning
// stores the actual address in NVS and the firmware does not query public NTP.
#define SECRET_NTP_SERVER "192.0.2.1"
