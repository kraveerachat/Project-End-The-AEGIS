          "expiresAt": "2026-09-12T08:02:00.000Z"
        }
      ]
    },
    "claimSuccess": {
      "actionId": "5b0e3c1e-8f6a-4c2d-9b7e-2f1a0c9d8e7f",
      "action": "CUT_UPLINK",
      "state": "CORE_CLAIMED",
      "claimedAt": "2026-09-12T08:00:30.000Z",
      "expiresAt": "2026-09-12T08:02:00.000Z"
    }
  },
  "neverImpliedByEvidence": ["executed", "physical_evidence"]
}
