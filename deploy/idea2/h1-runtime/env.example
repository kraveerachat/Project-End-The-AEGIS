# Contract only. Never put real values in this repository. An owner-approved
# env file must live outside all Git worktrees with owner-only permissions.
H1_POSTGRES_PASSWORD=
H1_APP_PASSWORD=
# URL-encode H1_APP_PASSWORD in the URL; host/database/user are fixed below.
H1_DATABASE_URL=postgresql://monitor_h1_app:<URL_ENCODED_APP_PASSWORD>@postgres:5432/aegis_h1_lab
H1_SESSION_SECRET=
# Exact reviewed source commit used for the Monitor image build, 40 hex chars.
H1_MONITOR_SOURCE_SHA=
# N3 only; never required by the unchanged N1 command. Real paths/material
# belong in the owner-only external env file, not this repository.
H1_GATEWAY_SOURCE_SHA=
H1_GATEWAY_BIND_IPV4=
H1_GATEWAY_HTTPS_PORT=
# N2/N3 offline trust validation input only; public CA, never a CA private key.
H1_PUBLIC_CA_PATH=
H1_TLS_CERT_PATH=
H1_TLS_KEY_PATH=
