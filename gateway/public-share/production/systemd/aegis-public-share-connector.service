# PUBLIC-SHARE-7 S5.5 connector lifecycle.
#
# STARTS an already-created, already-validated container. It never creates or
# recreates one, so the object ExecStartPre validated is exactly the object that
# starts - a bring-up here could otherwise replace the container after validation
# and start something unvalidated.
#
# The connector must already exist in a stopped state before this unit runs. That
# is done once, under separate S5.5-F authorization, by the bootstrap create step
# in the runbook, which is also what materialises the egress network and the
# aegis-ps-eg bridge the firewall needs.
#
# It operates ONLY the public-share-connector service, through the accepted
# four-layer Compose stack and the existing aegis-prod project. It never runs a
# whole-stack operation and never touches drive, the gateway, the database,
# monitoring or Twingate.
#
# BindsTo the firewall unit: if isolation stops, the connector stops with it, so
# the connector can never run without its egress/input policy in place.
#
# NOT INSTALLED BY THIS REPOSITORY. Installing, enabling or starting this unit
# on Production requires separate S5.5-F owner authorization.

[Unit]
Description=AEGIS Public Share S5.5 cloudflared connector
Documentation=file:///opt/aegis/runtime/public-share/README.md
Requires=aegis-public-share-s5-5-firewall.service
BindsTo=aegis-public-share-s5-5-firewall.service
After=aegis-public-share-s5-5-firewall.service docker.service
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/opt/aegis/runtime/public-share/s5-5-runtime-check.sh --pre-start
ExecStart=/usr/bin/docker compose --env-file /opt/aegis/Project-End-The-AEGIS/.env --project-name aegis-prod -f /opt/aegis/runtime/docker-compose.production.yml -f /opt/aegis/runtime/public-share/drive-s5-3.yml -f /opt/aegis/runtime/public-share/drive-gateway-s5-4.yml -f /opt/aegis/runtime/public-share/connector-s5-5.yml start public-share-connector
ExecStop=/usr/bin/docker compose --env-file /opt/aegis/Project-End-The-AEGIS/.env --project-name aegis-prod -f /opt/aegis/runtime/docker-compose.production.yml -f /opt/aegis/runtime/public-share/drive-s5-3.yml -f /opt/aegis/runtime/public-share/drive-gateway-s5-4.yml -f /opt/aegis/runtime/public-share/connector-s5-5.yml stop public-share-connector
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
