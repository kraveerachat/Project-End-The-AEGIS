# PUBLIC-SHARE-7 S5.5 fail-closed drift enforcement.
#
# Periodically re-checks the S5.5 invariants. On unsafe drift it stops ONLY
# aegis-public-share-connector.service. It never stops the gateway, drive, the
# database, monitoring, Twingate, the Docker daemon or UFW, and it never
# weakens or removes a firewall rule to "recover".
#
# NOT INSTALLED BY THIS REPOSITORY. Installing, enabling or starting this unit
# on Production requires separate S5.5-F owner authorization.

[Unit]
Description=AEGIS Public Share S5.5 connector drift enforcement
Documentation=file:///opt/aegis/runtime/public-share/README.md
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/aegis/runtime/public-share/s5-5-runtime-check.sh --enforce-drift
